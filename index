<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reaction Time Test</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .container {
            background: white;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            max-width: 700px;
            width: 100%;
            text-align: center;
        }

        h1 {
            color: #667eea;
            margin-bottom: 10px;
            font-size: 2.5em;
        }

        .subtitle {
            color: #666;
            margin-bottom: 30px;
            font-size: 1.1em;
        }

        #game-area {
            width: 100%;
            height: 400px;
            border-radius: 15px;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            font-size: 1.5em;
            font-weight: bold;
            transition: all 0.3s ease;
            margin-bottom: 20px;
            user-select: none;
        }

        .waiting {
            background: #3498db;
            color: white;
        }

        .ready {
            background: #e74c3c;
            color: white;
        }

        .click {
            background: #2ecc71;
            color: white;
        }

        .too-soon {
            background: #e74c3c;
            color: white;
        }

        .stats {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 15px;
            margin-bottom: 20px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }

        .stat-item {
            background: white;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .stat-label {
            font-size: 0.9em;
            color: #666;
            margin-bottom: 5px;
        }

        .stat-value {
            font-size: 1.8em;
            font-weight: bold;
            color: #667eea;
        }

        .attempts-list {
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: 15px;
        }

        .attempt-badge {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 10px 15px;
            border-radius: 20px;
            font-weight: bold;
            box-shadow: 0 3px 10px rgba(0,0,0,0.2);
        }

        button {
            padding: 15px 40px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 50px;
            font-size: 1.1em;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            margin: 5px;
        }

        button:hover {
            transform: translateY(-3px);
            box-shadow: 0 7px 20px rgba(0,0,0,0.3);
        }

        button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }

        .leaderboard {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 15px;
            margin-top: 30px;
            text-align: left;
        }

        .leaderboard h2 {
            color: #667eea;
            margin-bottom: 15px;
            text-align: center;
        }

        .leaderboard-item {
            background: white;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .rank {
            font-size: 1.5em;
            font-weight: bold;
            color: #667eea;
            width: 40px;
        }

        .username {
            flex: 1;
            font-weight: bold;
        }

        .score {
            color: #2ecc71;
            font-weight: bold;
            font-size: 1.2em;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .modal-content {
            background: white;
            padding: 30px;
            border-radius: 20px;
            max-width: 400px;
            width: 90%;
        }

        input {
            width: 100%;
            padding: 15px;
            border: 2px solid #667eea;
            border-radius: 10px;
            font-size: 1em;
            margin: 15px 0;
        }

        .info-box {
            background: #e3f2fd;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 20px;
            border-left: 4px solid #2196F3;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>⚡ Reaction Time Test</h1>
        <p class="subtitle">Test your reflexes - Click when green!</p>

        <div class="info-box">
            <strong>How to play:</strong> Click START, wait for the box to turn GREEN, then click as fast as you can! Complete 5 attempts to see your average.
        </div>

        <div id="game-area" class="waiting">
            Click START to begin
        </div>

        <div id="stats" class="stats" style="display: none;">
            <h3>📊 Your Results</h3>
            <div class="stats-grid">
                <div class="stat-item">
                    <div class="stat-label">Average Time</div>
                    <div class="stat-value" id="average-time">-</div>
                </div>
                <div class="stat-item">
                    <div class="stat-label">Best Time</div>
                    <div class="stat-value" id="best-time">-</div>
                </div>
                <div class="stat-item">
                    <div class="stat-label">Attempts</div>
                    <div class="stat-value" id="attempt-count">0/5</div>
                </div>
            </div>
            <div class="attempts-list" id="attempts-list"></div>
        </div>

        <div>
            <button id="start-btn" onclick="startGame()">🚀 START</button>
            <button id="reset-btn" onclick="resetGame()" style="display: none;">🔄 RESET</button>
            <button id="save-btn" onclick="showSaveModal()" style="display: none;">💾 SAVE SCORE</button>
        </div>

        <div class="leaderboard">
            <h2>🏆 Top 10 Leaderboard</h2>
            <div id="leaderboard-list">
                <p style="text-align: center; color: #999;">No scores yet. Be the first!</p>
            </div>
        </div>
    </div>

    <!-- Modal untuk save score -->
    <div id="save-modal" class="modal">
        <div class="modal-content">
            <h2 style="color: #667eea; margin-bottom: 10px;">Save Your Score</h2>
            <p style="color: #666; margin-bottom: 15px;">Enter your username to save to leaderboard</p>
            <input type="text" id="username-input" placeholder="Enter your name" maxlength="20">
            <button onclick="saveScore()">💾 Save</button>
            <button onclick="closeSaveModal()">Cancel</button>
        </div>
    </div>

    <script>
        let gameState = 'idle'; // idle, waiting, ready, finished
        let startTime = 0;
        let timeoutId = null;
        let attempts = [];
        const MAX_ATTEMPTS = 5;

        const gameArea = document.getElementById('game-area');
        const startBtn = document.getElementById('start-btn');
        const resetBtn = document.getElementById('reset-btn');
        const saveBtn = document.getElementById('save-btn');
        const statsDiv = document.getElementById('stats');

        function startGame() {
            if (attempts.length >= MAX_ATTEMPTS) {
                alert('Game completed! Click RESET to play again.');
                return;
            }

            gameState = 'waiting';
            gameArea.className = 'waiting';
            gameArea.textContent = 'Wait for GREEN...';
            startBtn.disabled = true;

            // Random delay between 2-6 seconds
            const delay = Math.random() * 4000 + 2000;

            timeoutId = setTimeout(() => {
                gameState = 'ready';
                gameArea.className = 'click';
                gameArea.textContent = 'CLICK NOW!';
                startTime = Date.now();
            }, delay);
        }

        gameArea.addEventListener('click', () => {
            if (gameState === 'waiting') {
                // Clicked too soon!
                clearTimeout(timeoutId);
                gameState = 'idle';
                gameArea.className = 'too-soon';
                gameArea.textContent = '❌ Too soon! Wait for GREEN\nClick START to try again';
                startBtn.disabled = false;
            } else if (gameState === 'ready') {
                // Valid click!
                const reactionTime = Date.now() - startTime;
                attempts.push(reactionTime);
                
                gameState = 'idle';
                gameArea.className = 'waiting';
                gameArea.textContent = `✅ ${reactionTime}ms\n${attempts.length >= MAX_ATTEMPTS ? 'Complete!' : 'Click START for next attempt'}`;
                
                updateStats();
                
                if (attempts.length >= MAX_ATTEMPTS) {
                    startBtn.style.display = 'none';
                    resetBtn.style.display = 'inline-block';
                    saveBtn.style.display = 'inline-block';
                } else {
                    startBtn.disabled = false;
                }
            }
        });

        function updateStats() {
            if (attempts.length === 0) return;

            const average = Math.round(attempts.reduce((a, b) => a + b) / attempts.length);
            const best = Math.min(...attempts);

            document.getElementById('average-time').textContent = average + ' ms';
            document.getElementById('best-time').textContent = best + ' ms';
            document.getElementById('attempt-count').textContent = `${attempts.length}/${MAX_ATTEMPTS}`;

            // Update attempts list
            const attemptsList = document.getElementById('attempts-list');
            attemptsList.innerHTML = attempts.map((time, index) => 
                `<div class="attempt-badge">Try ${index + 1}: ${time}ms</div>`
            ).join('');

            statsDiv.style.display = 'block';
        }

        function resetGame() {
            attempts = [];
            gameState = 'idle';
            gameArea.className = 'waiting';
            gameArea.textContent = 'Click START to begin';
            startBtn.disabled = false;
            startBtn.style.display = 'inline-block';
            resetBtn.style.display = 'none';
            saveBtn.style.display = 'none';
            statsDiv.style.display = 'none';
        }

        function showSaveModal() {
            document.getElementById('save-modal').style.display = 'flex';
            document.getElementById('username-input').focus();
        }

        function closeSaveModal() {
            document.getElementById('save-modal').style.display = 'none';
            document.getElementById('username-input').value = '';
        }

        async function saveScore() {
            const username = document.getElementById('username-input').value.trim();
            
            if (!username) {
                alert('Please enter your name!');
                return;
            }

            const average = Math.round(attempts.reduce((a, b) => a + b) / attempts.length);

            try {
                const response = await fetch('/api/score', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        username: username,
                        averageTime: average,
                        attempts: attempts
                    })
                });

                const result = await response.json();
                
                if (result.success) {
                    alert(`Score saved! Your rank: #${result.rank}`);
                    closeSaveModal();
                    loadLeaderboard();
                }
            } catch (error) {
                alert('Error saving score: ' + error.message);
            }
        }

        async function loadLeaderboard() {
            try {
                const response = await fetch('/api/leaderboard');
                const leaderboard = await response.json();
                
                const leaderboardDiv = document.getElementById('leaderboard-list');
                
                if (leaderboard.length === 0) {
                    leaderboardDiv.innerHTML = '<p style="text-align: center; color: #999;">No scores yet. Be the first!</p>';
                    return;
                }

                leaderboardDiv.innerHTML = leaderboard.map((score, index) => `
                    <div class="leaderboard-item">
                        <div class="rank">#${index + 1}</div>
                        <div class="username">${score.username}</div>
                        <div class="score">${score.averageTime}ms</div>
                    </div>
                `).join('');
            } catch (error) {
                console.error('Error loading leaderboard:', error);
            }
        }

        // Load leaderboard on page load
        loadLeaderboard();

        // Auto refresh leaderboard every 30 seconds
        setInterval(loadLeaderboard, 30000);
    </script>
</body>
</html>
